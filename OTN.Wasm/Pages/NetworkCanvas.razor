<section class="canvas-area">
    <div class="canvas-toolbar flex flex-wrap items-center gap-2 border-b px-3 py-2">
        <div class="flex flex-wrap items-center gap-1" role="group" aria-label="Editor mode">
            <BbButton Variant="@(_mode == EditorMode.Select ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Small" aria-pressed="@(_mode == EditorMode.Select)" OnClick="() => SetMode(EditorMode.Select)">
                <LucideIcon Name="mouse-pointer-2" Size="16" /> Select
            </BbButton>
            <BbButton Variant="@(_mode == EditorMode.Edit ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Small" aria-pressed="@(_mode == EditorMode.Edit)" OnClick="() => SetMode(EditorMode.Edit)">
                <LucideIcon Name="pencil" Size="16" /> Edit
            </BbButton>
        </div>
        @if (_mode == EditorMode.Edit)
        {
            <div class="flex flex-wrap items-center gap-1 border-l pl-2" role="group" aria-label="Edit tool">
                <BbButton Variant="@(_creationMode == CreationMode.Node ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Small" aria-pressed="@(_creationMode == CreationMode.Node)" OnClick="() => SetCreationMode(CreationMode.Node)">
                    <LucideIcon Name="plus" Size="16" /> Node
                </BbButton>
                <BbButton Variant="@(_creationMode == CreationMode.Link ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Small" aria-pressed="@(_creationMode == CreationMode.Link)" OnClick="() => SetCreationMode(CreationMode.Link)">
                    <LucideIcon Name="link-2" Size="16" /> Link
                </BbButton>
            </div>
            @if (_creationMode == CreationMode.Node)
            {
                <div class="flex flex-wrap items-center gap-1" role="group" aria-label="Node type">
                    <BbButton Variant="@(_newNodeType == NetNodeType.Terminal ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Small" aria-pressed="@(_newNodeType == NetNodeType.Terminal)" OnClick="() => SetNewNodeType(NetNodeType.Terminal)"><EditorObjectIcon NodeType="NetNodeType.Terminal" /> Terminal</BbButton>
                    <BbButton Variant="@(_newNodeType == NetNodeType.OLA ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Small" aria-pressed="@(_newNodeType == NetNodeType.OLA)" OnClick="() => SetNewNodeType(NetNodeType.OLA)"><EditorObjectIcon NodeType="NetNodeType.OLA" /> OLA</BbButton>
                    <BbButton Variant="@(_newNodeType == NetNodeType.ROADM ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Small" aria-pressed="@(_newNodeType == NetNodeType.ROADM)" OnClick="() => SetNewNodeType(NetNodeType.ROADM)"><EditorObjectIcon NodeType="NetNodeType.ROADM" /> ROADM</BbButton>
                </div>
                <span class="ml-auto text-xs text-muted-foreground">Click the canvas to place nodes</span>
            }
            else
            {
                <div class="flex flex-wrap items-center gap-1" role="group" aria-label="Link mode">
                    <BbButton Variant="@(_newLinkType == LinkType.Duplex ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Small" aria-pressed="@(_newLinkType == LinkType.Duplex)" OnClick="() => SetNewLinkType(LinkType.Duplex)"><EditorObjectIcon LinkDirection="LinkType.Duplex" Size="18" /> Duplex</BbButton>
                    <BbButton Variant="@(_newLinkType == LinkType.Simplex ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Small" aria-pressed="@(_newLinkType == LinkType.Simplex)" OnClick="() => SetNewLinkType(LinkType.Simplex)"><EditorObjectIcon LinkDirection="LinkType.Simplex" Size="18" /> Simplex</BbButton>
                </div>
                <span class="ml-auto text-xs text-muted-foreground">@(Document.PendingLinkSource is null ? "Select a source node" : "Select a target node · Escape to cancel")</span>
            }
        }
    </div>
    <div class="canvas-surface cursor-crosshair select-none" @onpointerdown="CanvasPointerDown" @onpointermove="CanvasPointerMove" @onpointerup="CanvasPointerUp" @onpointerleave="CanvasPointerLeave" @onwheel="Wheel" @onwheel:preventDefault="true" @onkeydown="CanvasKeyDown" tabindex="0">
        <Canvas Width="1000" Height="680" OnCanvasReady="CanvasReady" OnFrameReady="DrawFrame" />
    </div>
    <footer class="canvas-footer flex items-center gap-4 border-t px-3 py-2 text-xs text-muted-foreground">
        <span><BbKbd>Shift</BbKbd> + click requires · <BbKbd>Alt</BbKbd> + click avoids</span>
        <span>Scroll to zoom · drag canvas to pan</span>
        <span class="ml-auto">● Ready</span>
    </footer>
</section>
