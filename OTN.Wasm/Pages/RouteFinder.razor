@implements IDisposable

<div class="space-y-4">
    <div>
        <label class="mb-2 block text-sm font-medium">
            Source
            <BbCombobox TValue="string" Options="@_sourceNodeOptions" Value="@(Document.SourceRouteNode?.Node.Id.ToString() ?? string.Empty)" ValueChanged="SetSourceRouteNode" Placeholder="Select source" SearchPlaceholder="Search node type or ID" EmptyMessage="No eligible source nodes." MatchTriggerWidth="true" Class="mt-2 w-full" />
        </label>
    </div>
    <div>
        <label class="mb-2 block text-sm font-medium">
            Target
            <BbCombobox TValue="string" Options="@_targetNodeOptions" Value="@(Document.TargetRouteNode?.Node.Id.ToString() ?? string.Empty)" ValueChanged="SetTargetRouteNode" Placeholder="Select target" SearchPlaceholder="Search node type or ID" EmptyMessage="No eligible target nodes." MatchTriggerWidth="true" Class="mt-2 w-full" />
        </label>
    </div>

    <div class="space-y-2">
        <label class="block text-sm font-medium" for="route-node-search">Add constraints</label>
        <BbInput Id="route-node-search" Type="InputType.Search" Placeholder="Search node type or ID" Value="@_nodeSearch" ValueChanged="UpdateNodeSearch" UpdateTiming="UpdateTiming.Immediate" Class="w-full" />
        @if (string.IsNullOrWhiteSpace(_nodeSearch))
        {
            <p class="text-xs text-muted-foreground">Search to add a must or avoid node.</p>
        }
        else
        {
            <div class="max-h-48 overflow-auto rounded-md border" aria-label="Matching nodes">
                <Virtualize Items="_matchingNodes" Context="item" ItemSize="42">
                    <ItemContent>
                        <div @key="item.Node.Id" class="flex items-center justify-between gap-2 border-b p-2">
                            <span class="min-w-0">
                                <strong class="block text-sm">@item.Node.Type</strong>
                                <small class="block truncate text-xs text-muted-foreground" title="@item.Id">@item.Id</small>
                            </span>
                            <BbSelect TValue="string" Value="@NodeConstraint(item)" ValueChanged="value => SetNodeConstraint(item, value)" Class="w-24">
                                <BbSelectTrigger class="w-full" aria-label="@($"Constraint for {NodeOption(item)}")">
                                    <BbSelectValue />
                                </BbSelectTrigger>
                                <BbSelectContent>
                                    <BbSelectItem TValue="string" Value="@("none")" Text="None" />
                                    <BbSelectItem TValue="string" Value="@("must")" Text="Must" />
                                    <BbSelectItem TValue="string" Value="@("avoid")" Text="Avoid" />
                                </BbSelectContent>
                            </BbSelect>
                        </div>
                    </ItemContent>
                    <EmptyContent>
                        <p class="p-3 text-sm text-muted-foreground">No matching nodes.</p>
                    </EmptyContent>
                </Virtualize>
            </div>
        }
    </div>

    <div class="space-y-2">
        <h3 class="text-sm font-medium">Active constraints</h3>
        @if (Document.RequiredRouteNodes.Count + Document.AvoidedRouteNodes.Count == 0)
        {
            <p class="text-xs text-muted-foreground">No route constraints set.</p>
        }
        else
        {
            <div class="space-y-2">
                @foreach (var item in Document.RequiredRouteNodes)
                {
                    <div @key="item.Node.Id" class="flex items-center gap-2">
                        <BbBadge Variant="BadgeVariant.Default">Must</BbBadge>
                        <span class="min-w-0 flex-1 truncate text-sm" title="@item.Node.Id">@NodeOption(item)</span>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="@($"Clear required constraint for {NodeOption(item)}")" OnClick="() => Document.SetMustNode(item, false)">
                            <LucideIcon Name="x" Size="16" />
                        </BbButton>
                    </div>
                }
                @foreach (var item in Document.AvoidedRouteNodes)
                {
                    <div @key="item.Node.Id" class="flex items-center gap-2">
                        <BbBadge Variant="BadgeVariant.Secondary">Avoid</BbBadge>
                        <span class="min-w-0 flex-1 truncate text-sm" title="@item.Node.Id">@NodeOption(item)</span>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall" AriaLabel="@($"Clear avoided constraint for {NodeOption(item)}")" OnClick="() => Document.SetAvoidNode(item, false)">
                            <LucideIcon Name="x" Size="16" />
                        </BbButton>
                    </div>
                }
            </div>
        }
    </div>

    <div class="flex items-end gap-3">
        <label class="min-w-0 flex-1 text-sm font-medium" for="route-count">
            K shortest
            <BbNumericInput TValue="int" Id="route-count" @bind-Value="_routeCount" Min="1" Max="20" DisableDebounce="true" Disabled="@(Document.RequiredRouteNodes.Count > 0)" Class="mt-2 w-full" />
        </label>
        <BbButton Disabled="@Document.IsRouting" Loading="@Document.IsRouting" OnClick="RunSearch">Find route(s)</BbButton>
    </div>
    @if (Document.RequiredRouteNodes.Count > 0)
    {
        <p class="text-xs text-muted-foreground">Required nodes are visited in nearest-first order. K is inactive.</p>
    }
    @if (Document.IsRouting)
    {
        <div class="flex items-center gap-2 text-sm text-muted-foreground"><BbSpinner Size="SpinnerSize.Small" /> Searching routes…</div>
    }
    @if (Document.RouteError is { } error)
    {
        <BbAlert Variant="AlertVariant.Danger">
            <BbAlertTitle>Route search failed</BbAlertTitle>
            <BbAlertDescription>@error</BbAlertDescription>
        </BbAlert>
    }
    @if (Document.Routes.Count > 0)
    {
        <div class="space-y-2">
            <div class="flex items-center justify-between text-sm font-medium">
                <span>Results</span>
                <span class="text-muted-foreground">@Document.Routes.Count found</span>
            </div>
            @for (var i = 0; i < Document.Routes.Count; i++)
            {
                var index = i;
                var route = Document.Routes[i];
                <BbButton Variant="@(Document.SelectedRouteIndex == i ? ButtonVariant.Secondary : ButtonVariant.Outline)" Class="w-full justify-between text-left" OnClick="() => Document.SelectRouteCommand.Execute(index)">
                    <span class="min-w-0 truncate">@(i + 1). @route.Description · @route.Links.Count links</span>
                    <strong class="whitespace-nowrap">@route.Length.ToString("0.##") km</strong>
                </BbButton>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public NetworkEditorViewModel Document { get; set; } = null!;

    private int _routeCount = 3;
    private string _nodeSearch = "";
    private List<NodeViewModel> _matchingNodes = [];
    private NetworkEditorViewModel? _subscribedDocument;
    private IReadOnlyList<SelectOption<string>> _sourceNodeOptions = [];
    private IReadOnlyList<SelectOption<string>> _targetNodeOptions = [];
    private bool _renderQueued;
    private bool _refreshNodeOptions;
    private bool _refreshMatchingNodes;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribedDocument, Document)) return;
        if (_subscribedDocument is not null) _subscribedDocument.PropertyChanged -= DocumentChanged;
        _subscribedDocument = Document;
        _subscribedDocument.PropertyChanged += DocumentChanged;
        RefreshNodeOptions();
        RefreshMatchingNodes();
    }

    private void DocumentChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(NetworkEditorViewModel.Nodes)
            or nameof(NetworkEditorViewModel.SourceRouteNode)
            or nameof(NetworkEditorViewModel.TargetRouteNode)
            or nameof(NetworkEditorViewModel.SourceRouteNodeOptions)
            or nameof(NetworkEditorViewModel.TargetRouteNodeOptions)
            or nameof(NetworkEditorViewModel.RouteConstraintNodeOptions))
        {
            _refreshNodeOptions = true;
            _refreshMatchingNodes = true;
        }
        else if (e.PropertyName is not (nameof(NetworkEditorViewModel.RequiredRouteNodes)
            or nameof(NetworkEditorViewModel.AvoidedRouteNodes)
            or nameof(NetworkEditorViewModel.Routes)
            or nameof(NetworkEditorViewModel.SelectedRouteIndex)
            or nameof(NetworkEditorViewModel.RouteError)
            or nameof(NetworkEditorViewModel.IsRouting)))
        {
            return;
        }

        if (_renderQueued)
            return;

        _renderQueued = true;
        _ = InvokeAsync(FlushDocumentChanges);
    }

    private async Task FlushDocumentChanges()
    {
        await Task.Yield();

        if (_refreshNodeOptions)
        {
            _refreshNodeOptions = false;
            RefreshNodeOptions();
        }
        if (_refreshMatchingNodes)
        {
            _refreshMatchingNodes = false;
            RefreshMatchingNodes();
        }

        _renderQueued = false;
        StateHasChanged();
    }

    private void RefreshNodeOptions()
    {
        _sourceNodeOptions = BuildNodeOptions(Document.SourceRouteNodeOptions, "Select source");
        _targetNodeOptions = BuildNodeOptions(Document.TargetRouteNodeOptions, "Select target");
    }

    private static IReadOnlyList<SelectOption<string>> BuildNodeOptions(IEnumerable<NodeViewModel> nodes, string placeholder) =>
        new[] { new SelectOption<string>(string.Empty, placeholder) }
            .Concat(nodes.Select(item => new SelectOption<string>(item.Node.Id.ToString(), NodeOption(item))))
            .ToArray();

    public void Dispose()
    {
        if (_subscribedDocument is not null) _subscribedDocument.PropertyChanged -= DocumentChanged;
    }

    private static string NodeOption(NodeViewModel item) => string.Concat(item.Node.Type, " · ", item.Id);

    private void UpdateNodeSearch(string? value)
    {
        _nodeSearch = value ?? "";
        RefreshMatchingNodes();
    }

    private void RefreshMatchingNodes()
    {
        var query = _nodeSearch.Trim();
        _matchingNodes = query.Length == 0
            ? []
            : Document.RouteConstraintNodeOptions.Where(item =>
                item.Node.Type.ToString().Contains(query, StringComparison.OrdinalIgnoreCase)
                || item.Node.Id.ToString().Contains(query, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void SetSourceRouteNode(string? id) => Document.SetSourceRouteNode(FindNode(id));
    private void SetTargetRouteNode(string? id) => Document.SetTargetNode(FindNode(id));

    private NodeViewModel? FindNode(string? id) => Guid.TryParse(id, out var nodeId)
        ? Document.Nodes.FirstOrDefault(item => item.Node.Id == nodeId)
        : null;

    private string NodeConstraint(NodeViewModel item) => Document.IsMustNode(item)
        ? "must"
        : Document.IsAvoidNode(item) ? "avoid" : "none";

    private void SetNodeConstraint(NodeViewModel item, string? constraint)
    {
        switch (constraint)
        {
            case "must":
                Document.SetMustNode(item, true);
                break;
            case "avoid":
                Document.SetAvoidNode(item, true);
                break;
            default:
                Document.SetMustNode(item, false);
                Document.SetAvoidNode(item, false);
                break;
        }
    }

    private async Task RunSearch()
    {
        if (Document.SourceRouteNode is not { } source || Document.TargetRouteNode is not { } target) return;
        Document.PrepareRouteSearch();
        StateHasChanged();
        await Task.Delay(30);
        Document.FindRoutes(source.Node.Id, target.Node.Id, Math.Clamp(_routeCount, 1, 20));
    }
}
